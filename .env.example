# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Instructor approval/rejection emails (optional in development — when unset,
# emails are logged to the server console instead of being sent).
RESEND_API_KEY=""
EMAIL_FROM="KoolTech Fix IT Academy <no-reply@example.com>"
# Public base URL, used for the sign-in link in emails.
APP_URL="http://localhost:3001"

# Direct (non-pooled) connection, used by Prisma migrations (prisma.config.ts).
DIRECT_URL=""

# ── Auth (Better Auth) ────────────────────────────────────────────────────
# Secret for signing sessions, at least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (no trailing slash). Google redirects back to
# ${BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Lesson attachments (Cloudflare R2, private bucket) ────────────────────
# Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID="bb9e45814e379bf11f8cc2c27e1d33cd"
R2_ACCESS_KEY_ID="3fa9a33ec6c323e3dcd70490a9de89ae"
