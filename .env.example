# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Email (nodemailer over SMTP): password resets and instructor approval /
# rejection. Required in production. In development, when SMTP_HOST is
# unset, emails are logged to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_FROM="Kool TechFix I.T Academy <no-reply@example.com>"
# Public base URL, used for the sign-in link in emails.
APP_URL="http://localhost:3000"

# Direct (non-pooled) connection, used by Prisma migrations (prisma.config.ts).
DIRECT_URL=""

# ── Auth (Better Auth) ────────────────────────────────────────────────────
# Secret for signing sessions, at least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (no trailing slash). Google redirects back to
# ${BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Lesson attachments (Cloudflare R2, private bucket) ────────────────────
# Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_API_TOKEN=""
